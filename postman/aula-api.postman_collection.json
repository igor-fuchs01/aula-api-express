      "name": "1. Usuários (POST + body)",
      "item": [
        {
          "name": "Cadastrar usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/cadastrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "cadastrar"
              ]
            },
            "description": "201 criado · 400 campo faltando · 409 e-mail repetido",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeServer\": \"Aluno Teste\",\n  \"emailServer\": \"aluno@aula.com\",\n  \"senhaServer\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Autenticar (login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/autenticar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "autenticar"
              ]
            },
            "description": "200 OK · 403 e-mail/senha inválidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailServer\": \"professor@aula.com\",\n  \"senhaServer\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Erro 400 - sem senha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/autenticar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "autenticar"
              ]
            },
            "description": "Mostra a validação do controller",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailServer\": \"professor@aula.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
